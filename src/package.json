{
    "private": true,
    "type": "module",
    "dependencies": {
        "@inertiajs/vue3": "3.9.1",
        "@lucide/vue": "1.61.0",
        "@tailwindcss/vite": "4.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "laravel-vite-plugin": "3.2.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.64.1",
        "@types/node": "24.13.6",
        "@vitejs/plugin-vue": "6.0.7",
        "@vue/test-utils": "2.4.10",
        "jsdom": "28.1.0",
        "prettier": "3.9.7",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "4.1.11",
        "vue-tsc": "3.2.9"
    },
    "name": "weavdash",
    "description": "WeavDash Inertia foundation application",
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "dev": "vite",
