{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": [
                "./resources/js/*"
            ]
        },
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "types": [
            "vite/client",
            "node"
        ]
    },
    "vueCompilerOptions": {
        "strictTemplates": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "tests/Frontend/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "tests/Browser/**/*.ts",
        "playwright.config.ts"
    ]
}
